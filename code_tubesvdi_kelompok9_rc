DATA TRANSFORMATION
import pandas as pd
import ast

# Fungsi untuk ekstraksi kategori dari kolom spot_categories
def extract_category(spot_categories):
    try:
        # Mengubah string menjadi list/dictionary
        categories = ast.literal_eval(spot_categories)
        # Mengambil nilai 'name' dari elemen pertama
        return categories[0]['name'] if categories else None
    except (ValueError, IndexError, KeyError):
        return None

# Membuat kolom baru dengan hasil kategori
data1['category'] = data1['spot_categories'].apply(extract_category)


DATA AGGREGATION
# Mengelompokkan data berdasarkan kategori dan menghitung jumlah check-in
category_summary = (
    data1.groupby('category')['checkins_count']
    .sum()
    .reset_index()
    .sort_values(by='checkins_count', ascending=False)
)

# Memilih 10 kategori dengan jumlah check-in terbanyak
top_10_categories = category_summary.head(10)


